@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://adafede.github.io/sparql-examples/examples/Taxa/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:wd_taxa_distribution_map a sh:SPARQLExecutable , sh:SPARQLSelectExecutable ;
    rdfs:comment "Taxa distribution map."@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
#defaultView:Map
SELECT ?taxon ?taxon_name ?map ?rgb WHERE {
    VALUES ?parent {
        wd:Q10908
    }
    ?parent ^(wdt:P171*) ?taxon .
    ?taxon wdt:P8485 ?map ;
           wdt:P225 ?taxon_name .
    BIND(SUBSTR(SHA1(STR(?taxon)), 1, 6) AS ?rgb)
}
""" ;
    schema:target <https://qlever.dev/api/wikidata> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    schema:keywords "taxa" ;
    dc:creator "Adriano Rutz" .
