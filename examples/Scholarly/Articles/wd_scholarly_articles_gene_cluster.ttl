@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://adafede.github.io/sparql-examples/examples/Scholarly/Articles/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:wd_scholarly_articles_gene_cluster a sh:SPARQLExecutable , sh:SPARQLSelectExecutable ;
    rdfs:comment "Scholarly articles mentioning 'gene cluster' in title cited as references for natural product taxon occurrences."@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX pr: <http://www.wikidata.org/prop/reference/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
#title: Scholarly articles mentioning 'gene cluster' in title cited as references for natural product taxon occurrences
SELECT DISTINCT ?article ?article_doi ?article_title WHERE {
    {
        SELECT DISTINCT ?article WHERE {
            ?s wdt:P235 [] ;
               p:P703/prov:wasDerivedFrom/pr:P248 ?article .
        }
    }
    ?article wdt:P1476 ?article_title ;
             wdt:P356 ?article_doi .
    FILTER(CONTAINS(LCASE(STR(?article_title)), "gene cluster"))
}
""" ;
    schema:target <https://qlever.dev/api/wikidata> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    schema:keywords "scholarly articles" , "gene cluster" ;
    dc:creator "Adriano Rutz" .
