@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

_:sparql_examples_prefixes
  a owl:Ontology ;
  rdfs:comment "Common prefix declarations for SPARQL query examples."@en ;
  owl:imports sh: .

_:sparql_examples_prefixes sh:declare _:prefix_rdf .
_:prefix_rdf
  sh:prefix "rdf" ;
  sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_rdfs .
_:prefix_rdfs
  sh:prefix "rdfs" ;
  sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_skos .
_:prefix_skos
  sh:prefix "skos" ;
  sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_owl .
_:prefix_owl
  sh:prefix "owl" ;
  sh:namespace "http://www.w3.org/2002/07/owl#"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_xsd .
_:prefix_xsd
  sh:prefix "xsd" ;
  sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_sh .
_:prefix_sh
  sh:prefix "sh" ;
  sh:namespace "http://www.w3.org/ns/shacl#"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_spex .
_:prefix_spex
  sh:prefix "spex" ;
  sh:namespace "https://purl.expasy.org/sparql-examples/ontology#"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_schema .
_:prefix_schema
  sh:prefix "schema" ;
  sh:namespace "https://schema.org/"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_dc .
_:prefix_dc
  sh:prefix "dc" ;
  sh:namespace "http://purl.org/dc/elements/1.1/"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_dcterms .
_:prefix_dcterms
  sh:prefix "dcterms" ;
  sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_prov .
_:prefix_prov
  sh:prefix "prov" ;
  sh:namespace "http://www.w3.org/ns/prov#"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_bd .
_:prefix_bd
  sh:prefix "bd" ;
  sh:namespace "http://www.bigdata.com/rdf#"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_hint .
_:prefix_hint
  sh:prefix "hint" ;
  sh:namespace "http://www.bigdata.com/queryHints#"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_mwapi .
_:prefix_mwapi
  sh:prefix "mwapi" ;
  sh:namespace "https://www.mediawiki.org/ontology#API/"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_wikibase .
_:prefix_wikibase
  sh:prefix "wikibase" ;
  sh:namespace "http://wikiba.se/ontology#"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_wd .
_:prefix_wd
  sh:prefix "wd" ;
  sh:namespace "http://www.wikidata.org/entity/"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_wdt .
_:prefix_wdt
  sh:prefix "wdt" ;
  sh:namespace "http://www.wikidata.org/prop/direct/"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_p .
_:prefix_p
  sh:prefix "p" ;
  sh:namespace "http://www.wikidata.org/prop/"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_ps .
_:prefix_ps
  sh:prefix "ps" ;
  sh:namespace "http://www.wikidata.org/prop/statement/"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_psv .
_:prefix_psv
  sh:prefix "psv" ;
  sh:namespace "http://www.wikidata.org/prop/statement/value/"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_pq .
_:prefix_pq
  sh:prefix "pq" ;
  sh:namespace "http://www.wikidata.org/prop/qualifier/"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_pqv .
_:prefix_pqv
  sh:prefix "pqv" ;
  sh:namespace "http://www.wikidata.org/prop/qualifier/value/"^^xsd:anyURI .

_:sparql_examples_prefixes sh:declare _:prefix_pr .
_:prefix_pr
  sh:prefix "pr" ;
  sh:namespace "http://www.wikidata.org/prop/reference/"^^xsd:anyURI .
