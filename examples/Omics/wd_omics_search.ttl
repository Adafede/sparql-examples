@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://adafede.github.io/sparql-examples/examples/Omics/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:wd_omics_search a sh:SPARQLExecutable , sh:SPARQLSelectExecutable ;
    rdfs:comment "Which taxa have children (or themselves) with known chemicals, genes, and proteins? (by child taxon)"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
#title: Which taxa have children (or themselves) with known chemicals, genes, and proteins? (by child taxon)
SELECT ?taxon ?child (COUNT(DISTINCT ?g) AS ?genome) (COUNT(DISTINCT ?m) AS ?metabolome) (COUNT(DISTINCT ?p) AS ?proteome) WHERE {
    VALUES ?taxon {
        wd:Q31856
    }
    ?taxon ^(wdt:P171*) ?child .
    ?thing wdt:P703 ?child .
    {
        VALUES ?chemical {
            wd:Q113145171
            wd:Q59199015
        }
        ?thing wdt:P31 ?chemical .
        BIND(?thing AS ?m)
    }
    UNION
    {
        ?thing wdt:P31 wd:Q8054 .
        BIND(?thing AS ?p)
    }
    UNION
    {
        ?thing wdt:P31 wd:Q7187 .
        BIND(?thing AS ?g)
    }
}
GROUP BY ?taxon ?child
""" ;
    schema:target <https://qlever.dev/api/wikidata> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    schema:keywords "omics" ;
    dc:creator "Adriano Rutz" .
