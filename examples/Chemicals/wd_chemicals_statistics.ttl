@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://adafede.github.io/sparql-examples/examples/Chemicals/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:wd_chemicals_statistics a sh:SPARQLExecutable , sh:SPARQLSelectExecutable ;
    rdfs:comment "Chemicals statistics."@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
#title: Chemicals statistics
SELECT ?count ?description WHERE {
    {
        SELECT (COUNT(DISTINCT ?item) AS ?count) ?description WHERE {
            VALUES ?chem_class { wd:Q113145171 wd:Q59199015 }
            ?item wdt:P31 ?chem_class .
            BIND("Total chemicals with or without stereochemistry" AS ?description)
        }
        GROUP BY ?description
    }
    UNION
    {
        SELECT (COUNT(DISTINCT ?item) AS ?count) ?description WHERE {
            ?item wdt:P31 wd:Q113145171 .
            BIND("Total chemicals with fully defined stereochemistry" AS ?description)
        }
        GROUP BY ?description
    }
    UNION
    {
        SELECT (COUNT(DISTINCT ?item) AS ?count) ?description WHERE {
            ?item wdt:P31 wd:Q59199015 .
            BIND("Total chemicals with undefined stereochemistry" AS ?description)
        }
        GROUP BY ?description
    }
    UNION
    {
        SELECT ?count (CONCAT("Total chemicals with ", ?propLabel) AS ?description) WHERE {
            {
                SELECT ?p (COUNT(DISTINCT ?item) AS ?count) WHERE {
                    VALUES ?chem_class { wd:Q113145171 wd:Q59199015 }
                    ?item wdt:P31 ?chem_class ;
                          ?p [] .
                }
                GROUP BY ?p
            }
            VALUES ?p {
                wdt:P231 wdt:P233 wdt:P234 wdt:P235 wdt:P274 wdt:P592 wdt:P661 wdt:P662
                wdt:P665 wdt:P683 wdt:P703 wdt:P1117 wdt:P2017 wdt:P2067 wdt:P2084
                wdt:P2101 wdt:P2102 wdt:P2177 wdt:P2201 wdt:P2260 wdt:P3636 wdt:P4952
                wdt:P4964 wdt:P6689 wdt:P8533 wdt:P9405 wdt:P11375
            }
            ?prop wikibase:directClaim ?p ;
                  rdfs:label ?propLabel .
            FILTER(LANG(?propLabel) = "en")
        }
    }
}
ORDER BY DESC(?count)
""" ;
    schema:target <https://qlever.dev/api/wikidata> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    schema:keywords "chemicals" ;
    dc:creator "Adriano Rutz" .
