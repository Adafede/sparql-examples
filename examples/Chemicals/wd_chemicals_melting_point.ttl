@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://adafede.github.io/sparql-examples/examples/Chemicals/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:wd_chemicals_melting_point a sh:SPARQLExecutable , sh:SPARQLSelectExecutable ;
    rdfs:comment "Chemicals with melting point and their units."@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX ps: <http://www.wikidata.org/prop/statement/>
PREFIX psv: <http://www.wikidata.org/prop/statement/value/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
#title: Chemicals with melting point and their units
SELECT ?item ?itemLabel ?inchikey ?melting_point ?unit ?unitLabel WHERE {
    ?item wdt:P235 ?inchikey ;
          p:P2101 ?statement .
    ?statement a wikibase:BestRank ;
               ps:P2101 ?melting_point ;
               psv:P2101/wikibase:quantityUnit ?unit .
    OPTIONAL {
        ?item rdfs:label ?itemLabel .
        FILTER(LANG(?itemLabel) = "en")
    }
    OPTIONAL {
        ?unit rdfs:label ?unitLabel .
        FILTER(LANG(?unitLabel) = "en")
    }
}
""" ;
    schema:target <https://qlever.dev/api/wikidata> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    schema:keywords "chemicals" ;
    dc:creator "Adriano Rutz" .
