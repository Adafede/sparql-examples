@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://adafede.github.io/sparql-examples/examples/Chemicals/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:wd_chemicals_inchikeys a sh:SPARQLExecutable , sh:SPARQLSelectExecutable ;
    rdfs:comment "Which chemicals contain given short InChIKey(s) (first layer of 14 characters)?"@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
#title: Which chemicals contain given short InChIKey(s) (first layer of 14 characters)?
SELECT ?item ?inchikey WHERE {
    {
        ?item wdt:P235 ?inchikey .
        FILTER(REGEX(?inchikey, "^BUOYQGLRFDDTLB-"))
    }
    UNION
    {
        ?item wdt:P235 ?inchikey .
        FILTER(REGEX(?inchikey, "^IOSXSVZRTUWBHC-"))
    }
}
""" ;
    schema:target <https://qlever.dev/api/wikidata> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    schema:keywords "chemicals" ;
    dc:creator "Adriano Rutz" .
