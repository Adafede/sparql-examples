@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://adafede.github.io/sparql-examples/examples/Chemicals/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:wd_chemicals_solubility a sh:SPARQLExecutable , sh:SPARQLSelectExecutable ;
    rdfs:comment "Chemicals with solubility, solvent, temperature and their units."@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX pq: <http://www.wikidata.org/prop/qualifier/>
PREFIX pqv: <http://www.wikidata.org/prop/qualifier/value/>
PREFIX ps: <http://www.wikidata.org/prop/statement/>
PREFIX psv: <http://www.wikidata.org/prop/statement/value/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
#title: Chemicals with solubility, solvent, temperature and their units
SELECT ?item ?itemLabel ?inchikey ?solubility ?unit_solubility ?unit_solubilityLabel ?solvent ?solventLabel ?temperature ?unit_temperature ?unit_temperatureLabel WHERE {
    ?item wdt:P235 ?inchikey ;
          p:P2177 ?statement .
    ?statement a wikibase:BestRank ;
               ps:P2177 ?solubility ;
               pq:P2178 ?solvent ;
               psv:P2177/wikibase:quantityUnit ?unit_solubility .
    OPTIONAL {
        ?statement pq:P2076 ?temperature ;
                   pqv:P2076/wikibase:quantityUnit ?unit_temperature .
        OPTIONAL {
            ?unit_temperature rdfs:label ?unit_temperatureLabel .
            FILTER(LANG(?unit_temperatureLabel) = "en")
        }
    }
    OPTIONAL {
        ?item rdfs:label ?itemLabel .
        FILTER(LANG(?itemLabel) = "en")
    }
    OPTIONAL {
        ?solvent rdfs:label ?solventLabel .
        FILTER(LANG(?solventLabel) = "en")
    }
    OPTIONAL {
        ?unit_solubility rdfs:label ?unit_solubilityLabel .
        FILTER(LANG(?unit_solubilityLabel) = "en")
    }
}
""" ;
    schema:target <https://qlever.dev/api/wikidata> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    schema:keywords "chemicals" ;
    dc:creator "Adriano Rutz" .
