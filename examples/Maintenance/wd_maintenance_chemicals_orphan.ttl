@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://adafede.github.io/sparql-examples/examples/Maintenance/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:wd_maintenance_chemicals_orphan a sh:SPARQLExecutable , sh:SPARQLSelectExecutable ;
    rdfs:comment "Maintenance: add subclasses to orphan chemical entities."@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
#title: Maintenance: add subclasses to orphan chemical entities
SELECT DISTINCT (STRAFTER(STR(?item), "entity/") AS ?qid) ("Q11173" AS ?P279) WHERE {
    VALUES ?chemicals {
        wd:Q113145171
        wd:Q59199015
    }
    ?item wdt:P31 ?chemicals .
    MINUS { ?item p:P279 [] . }
}
""" ;
    schema:target <https://qlever.dev/api/wikidata> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    schema:keywords "maintenance" , "chemicals" ;
    dc:creator "Adriano Rutz" .
