@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ex: <https://adafede.github.io/sparql-examples/examples/Maintenance/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:wd_maintenance_chemicals_inferred_statements a sh:SPARQLExecutable , sh:SPARQLSelectExecutable ;
    rdfs:comment "Statements inferred more than once from the same chemical property."@en ;
    sh:prefixes _:sparql_examples_prefixes ;
    sh:select """
PREFIX pr: <http://www.wikidata.org/prop/reference/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX wd: <http://www.wikidata.org/entity/>
#title: Statements inferred more than once from the same chemical property
SELECT ?item ?p ?statement (COUNT(?ref) AS ?count) WHERE {
    VALUES ?inferred {
        # wd:Q123137214
        wd:Q113993940
        # wd:Q113907573
        # wd:Q123282952
    }
    ?item ?p ?statement .
    ?statement prov:wasDerivedFrom ?ref .
    ?ref pr:P887 ?inferred .
}
GROUP BY ?item ?p ?statement ?inferred
HAVING (?count > 1)
""" ;
    schema:target <https://qlever.dev/api/wikidata> ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    schema:keywords "maintenance" , "chemicals" ;
    dc:creator "Adriano Rutz" .
